* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.png binary
*.pdf binary
*.docx binary
*.npz binary
*.pptx binary
*.zip binary
*.gz binary
*.ps1 text eol=crlf
